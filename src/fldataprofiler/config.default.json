{
  "global": {
    "output_dir": "reports",
    "max_rows": 50000,
    "random_state": 42,
    "min_non_null": 10
  },
  "prune": {
    "max_corr": 0.85,
    "corr_method": "pearson",
    "max_null": 0.20,
    "min_variance": 0.0,
    "auto_drop_raw_levels": true,
    "output_path": "datasets/selected_feature.parquet",
    "summary_json": "reports/prune_summary.json"
  },
  "modules": {
    "probability_prim": {
      "min_box_samples": 250,
      "min_support": 0.005,
      "alpha": 0.05,
      "max_candidates": 16,
      "expand_delta": 0.01,
      "objective": "support_weighted"
    },
    "probability_markov": {
      "n_quantiles": 5,
      "max_candidates": 16,
      "min_transition_samples": 30
    },
    "probability_scorecard": {
      "n_bins": 10,
      "max_features": 12,
      "base_score": 600,
      "pdo": 20
    },
    "probability": {
      "n_quantiles": 20
    },
    "probability_2d": {
      "n_bins": 10,
      "max_candidates": 16
    },
    "probability_3d": {
      "n_bins": 5,
      "max_candidates": 10
    },
    "probability_drift": {
      "n_folds": 5,
      "n_quantiles": 10
    },
    "probability_kellycriterion": {
      "n_quantiles": 20,
      "win_loss_ratio": 1.5
    },
    "xgboost": {
      "n_estimators": 100,
      "max_depth": 5,
      "learning_rate": 0.05
    },
    "lightgbm": {
      "n_estimators": 100,
      "learning_rate": 0.05
    }
  }
}
